# Any build tree: build/, plus the sanitizer and per-config ones the Makefile
# targets create (build-asan/, build-debug/, build-release/, ...).
build*/
.DS_Store
.dmux/
.dmux-hooks/

# Android
android/local.properties
android/.gradle/
android/app/build/
android/app/.cxx/
android/build/
android/.idea/workspace.xml
android/.claude/
android/.idea/*

# Docs site
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/

# Agent worktrees. Isolated checkouts of this same repository, created under
# .claude/ while background agents run and removed when they finish -- never
# content, and committing them would nest the repo inside itself.
.claude/worktrees/
